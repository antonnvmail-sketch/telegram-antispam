# Never commit a filled-in .env. Get your own bot token from BotFather.
TELEGRAM_TOKEN=
# Comma-separated numeric IDs, no @names. Set your own values.
ADMIN_IDS=
CHAT_IDS=
DATASET_PATH=dataset.sqlite
MODEL_PATH=model.joblib
LOG_FILE=bot.log
LOG_MAX_BYTES=1048576
LOG_BACKUP_COUNT=3
SPAM_DELETE_THRESHOLD=0.7
SPAM_MODERATE_THRESHOLD=0.4
# true: record proposed actions locally, never automatically delete/notify.
# Bot commands still respond to the person who invokes them.
DRY_RUN=true
# Optional comparison model. Disabled; no private model is distributed.
SHADOW_MODE_ENABLED=false
SHADOW_MODEL_PATH=models/shadow.joblib
SHADOW_MODEL_VERSION=custom
SHADOW_DB_PATH=dataset.sqlite
SHADOW_DB_TIMEOUT_SECONDS=0.25
# Optional local Monitor SC delivery timestamps; off by default.
MONITOR_SC_ENABLED=false
